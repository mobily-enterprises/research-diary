---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" />
  <link href="{{ '/' | absolute_url }}" />
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% assign latest = site.research | sort: 'ended' | last %}{{ latest.ended | date_to_xmlschema }}</updated>
  {% assign feed_entries = site.research | sort: "ended" | reverse %}
  {% for entry in feed_entries limit: 20 %}
  <entry>
    <title>{{ entry.title | xml_escape }}</title>
    <link href="{{ entry.url | absolute_url }}" />
    <id>{{ entry.url | absolute_url }}</id>
    <updated>{{ entry.ended | date_to_xmlschema }}</updated>
    <summary>{{ entry.summary | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>

